/// Comprehensive responsibility projection (epic #631). Carries every field across the reactive /
/// standing / recurring archetypes -- trigger discriminator, schedule (recurring), condition
/// (reactive), target binding (assistant / specialist / unassigned + assignedAgentId /
/// assignedRoleSlug), scope pin, lifecycle status + enabled flag, and the lastEvaluatedAt /
/// lastResult run bookkeeping the reactive-loop epic #632 consumes.
@row
shape responsibility responsibilityFull {
  row.id
  ownerUserId
  statement
  trigger
  schedule
  condition
  targetKind
  assignedAgentId
  assignedRoleSlug
  successCriteria
  notifyHow
  scopePartitionId
  enabled
  status
  intakeStatus
  intakeRequest
  intakeResponse
  lastEvaluatedAt
  lastResult
  row.createdAt
  row.createdBy
}
