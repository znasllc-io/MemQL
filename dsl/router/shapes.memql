// Generated by scripts/restructure-by-construct.
// Per-construct DSL layout: every <kind>s.memql file in a domain
// holds every construct of that kind in the domain. The companion
// files cover the other construct kinds.

/// Full projection of a v1:router:budget record. The current-period spend is computed client-side
/// by summing v1:router:call rows within the period window -- not stored on the row itself.
@row
shape budget budgetFull {
  row.id
  row.createdAt
  scope
  scopeId
  periodType
  limitUSD
  alertThresholdPct
  alertSent
  resetAt
  active
}

/// One AI routing decision, as an operator reads it. Projects what was asked
/// for, what served, which rule and policy decided, and what it cost.
///
/// It deliberately projects NEITHER the prompt nor the error message. A
/// decision record answers "why did this go to a vendor", and neither of those
/// is needed to answer it -- while both are the fields most likely to carry
/// something a reader of this list should not see.
@row
shape call routerDecision {
  row.id
  row.createdAt
  requestId
  promptName
  level
  requestedLevel
  servedLevel
  degraded
  rule
  policy
  door
  providerName
  vendor
  model
  considered
  touches
  minContextTokens
  machineOwnerUserId
  totalCost
  totalDurationMs
  outcome
  billing
  executionSurface
}

/// Full projection of one router call, for the nightly evidence fold.
///
/// NARROW ON PURPOSE. The fold counts calls, structured failures and outcomes; it does not read
/// costs, tokens or error messages, and projecting them would put a week of prompt-adjacent text
/// through a sweep that has no use for it.
@row
shape call routerCallEvidence {
  row.id
  model
  promptName
  outcome
  errorCategory
  billing
  row.createdAt
}
